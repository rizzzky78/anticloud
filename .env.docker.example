# ──────────────────────────────────────────────────────────────────────────────
# anticloud — Docker runtime environment
#
#   cp .env.docker.example .env      then fill in real values.
#
# docker-compose reads THIS file as `.env` for two purposes:
#   1. `env_file` — injected into the app & worker containers and validated at
#      boot by lib/env.ts (a missing/bad value fails the container fast).
#   2. Variable substitution in docker-compose.yml — COMPOSE_PROFILES and the
#      POSTGRES_* / MINIO_* credentials for the optional local containers.
#
# CHOOSE PER SERVICE: cloud or local. Enable a local container by adding its
# profile to COMPOSE_PROFILES below; otherwise point the URL/endpoint at cloud.
# ──────────────────────────────────────────────────────────────────────────────

NODE_ENV=production

# ── Which optional local containers to start ──────────────────────────────────
# Comma-separated. Include a profile to run that service locally; omit it to use
# a cloud provider (then set the matching URL/endpoint below to the cloud value).
#   local-postgres  local-redis  local-minio  nginx
# Example — everything local + nginx TLS:
#   COMPOSE_PROFILES=local-postgres,local-redis,local-minio,nginx
# Example — fully cloud backends, host nginx:
#   COMPOSE_PROFILES=
COMPOSE_PROFILES=local-postgres,local-redis,local-minio,nginx

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# LOCAL (profile local-postgres): host is the service name `postgres`. The
#   POSTGRES_* vars below seed that container AND must match this URL.
# CLOUD (Neon/Supabase/RDS): drop the local-postgres profile and set the cloud
#   URL, e.g. postgresql://USER:PASS@HOST/DB?sslmode=require
DATABASE_URL=postgresql://postgres:CHANGE_ME@postgres:5432/anticloud
# Only used to seed the local-postgres container (ignored for cloud).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=anticloud

# ── Redis ─────────────────────────────────────────────────────────────────────
# LOCAL (profile local-redis): host is the service name `redis`.
# CLOUD (Upstash, …): drop the profile and use a rediss:// TLS URL, e.g.
#   rediss://default:PASSWORD@HOST:6379
REDIS_URL=redis://redis:6379

# ── Object storage (S3-compatible) ────────────────────────────────────────────
# LOCAL (profile local-minio): the MINIO_ACCESS_KEY/MINIO_SECRET_KEY below also
#   seed the MinIO container's root credentials.
#   ⚠ Presigned download URLs (bulk archive) are opened by the user's BROWSER,
#   so MINIO_ENDPOINT must be a host the browser can reach — NOT `minio` (the
#   container name). Use the public host/IP (MinIO's 9000 is published), or
#   proxy MinIO through nginx and set a public hostname here. See deploy/README.md.
#
# CLOUD — drop the local-minio profile and set, for example:
#   Cloudflare R2:  MINIO_ENDPOINT=<ACCOUNT_ID>.r2.cloudflarestorage.com
#                   MINIO_PORT=443  MINIO_USE_SSL=true  MINIO_REGION=auto
#   AWS S3:         MINIO_ENDPOINT=s3.<region>.amazonaws.com
#                   MINIO_PORT=443  MINIO_USE_SSL=true  MINIO_REGION=<region>
MINIO_ENDPOINT=files.example.com
MINIO_PORT=9000
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME
MINIO_BUCKET=anticloud
MINIO_USE_SSL=false
# Cloud only — leave unset for local MinIO.
# MINIO_REGION=auto
# MINIO_PATH_STYLE=true

# ── Better-Auth ───────────────────────────────────────────────────────────────
# 32+ char random secret:  openssl rand -base64 32
BETTER_AUTH_SECRET=CHANGE_ME_generate_a_32_plus_char_secret
# Public URL users hit — must match how the browser addresses the app (nginx
# server_name). With the nginx profile + a domain: https://files.example.com
BETTER_AUTH_URL=https://files.example.com

# ── Application ───────────────────────────────────────────────────────────────
APP_URL=https://files.example.com

# Secret guarding the TTL-expiry cron endpoint (app/api/cron/expire).
CRON_SECRET=CHANGE_ME_random_cron_secret
