# =============================================================================
# anticloud — environment contract
#
# Copy to `.env` and fill in real values, then deploy with:
#   docker compose --env-file .env up -d --build
#
# This is the single source of truth consumed by lib/env.ts, which validates
# every variable at startup (the process fails fast on a missing/invalid value).
#
# Backing services (Postgres, DragonflyDB, MinIO) run as separate containers on
# the SAME host and publish their default ports. From inside these app
# containers they are reachable at `host.docker.internal` (see docker-compose).
# =============================================================================

# --- Runtime ----------------------------------------------------------------
NODE_ENV=production

# --- Host HTTPS port (consumed by docker-compose, NOT by the app) -----------
# nginx publishes this port and terminates TLS. Must match the port in the URLs
# below. Defaults to 3070 if unset.
HTTPS_PORT=3070

# --- Public application URL -------------------------------------------------
# The address users hit on the intranet (through nginx / HTTPS). Better-Auth and
# the app use these to build absolute URLs, so they MUST match what the browser
# actually requests, including scheme and port.
APP_URL=https://10.54.204.59:3070
BETTER_AUTH_URL=https://10.54.204.59:3070

# --- Better-Auth ------------------------------------------------------------
# Secret used to sign sessions/tokens. MUST be at least 32 characters.
# Generate one with:  openssl rand -base64 48
BETTER_AUTH_SECRET=change_me_to_a_random_string_at_least_32_chars

# --- PostgreSQL -------------------------------------------------------------
# postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://anticloud:change_me@host.docker.internal:5432/anticloud

# --- Redis / DragonflyDB ----------------------------------------------------
# redis://[:<password>@]<host>:<port>
REDIS_URL=redis://host.docker.internal:6379

# --- MinIO (S3-compatible object storage) -----------------------------------
MINIO_ENDPOINT=host.docker.internal
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=change_me
MINIO_SECRET_KEY=change_me
MINIO_BUCKET=anticloud

# --- Cron / scheduled endpoints ---------------------------------------------
# Shared secret guarding internal cron routes (e.g. /api/cron/expire).
# Generate one with:  openssl rand -hex 32
CRON_SECRET=change_me_to_a_random_secret
