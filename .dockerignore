# Dependencies & build output (rebuilt inside the image)
node_modules
.next
out
build

# Version control & CI
.git
.github
.gitignore

# Logs (mounted as a volume at runtime; do not bake into the image)
logs
*.log

# Local env files — secrets are injected at runtime via env_file, never copied
.env
.env.*
!.env.production.example

# Docker / deploy artifacts (not needed inside the build context)
# COPYs it into the runner image.
Dockerfile
docker-compose.yml
.dockerignore
nginx

# Editor / OS cruft
.vscode
.idea
.DS_Store
Thumbs.db

# Tests & coverage
coverage
**/*.test.ts
**/*.spec.ts

# Misc local-only docker subprojects shared in repo
docker/psql
docker/minio