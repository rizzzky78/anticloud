// Anticloud — full data model.
//
// Consolidated schema for all phases. Sections are ordered by the plan in
// `plan/`. The Postgres connection is driven at runtime by the
// `@prisma/adapter-pg` driver adapter (see `lib/db.ts`); the `url` below is used
// only by the Prisma CLI (migrate/introspect/studio). `.env` is loaded for the
// CLI by `prisma.config.ts`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────────

/// System- and file-level access tiers. Resolution order lives in
/// `lib/permissions.ts` (see plan/phase-02-rbac.md).
/// `EDITOR` is file-level only (plan/phase-14): read + upload new versions +
/// notes/tags, without manage rights. It is never assigned as a system role.
enum Role {
  SUPERADMIN
  ADMIN
  EDITOR
  VIEWER
  GUEST
}

/// File visibility. `PRIVATE` → owner + explicit grants only; `PUBLIC` →
/// any authenticated user (+ guests when `guestAccess` is true).
enum Visibility {
  PUBLIC
  PRIVATE
}

/// Background job categories (plan/phase-09).
enum JobType {
  TTL_EXPIRY
  BULK_ARCHIVE
  COMPRESSION
  THUMBNAIL
}

/// Background job lifecycle. `DEAD_LETTER` = retries exhausted, awaiting
/// superadmin review.
enum JobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  DEAD_LETTER
}

// ─────────────────────────────────────────────────────────────────────────────
// Authentication (Better-Auth: username + password). plan/phase-01-auth.md
// Field names/shapes mirror Better-Auth's generated schema so the adapter works
// without custom mapping. `role` is our RBAC extension.
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id            String  @id @default(cuid())
  name          String
  email         String  @unique
  emailVerified Boolean @default(false)
  image         String?

  // Username plugin.
  username        String? @unique
  displayUsername String?

  // RBAC system role (plan/phase-02). File-level grants live in FilePermission.
  role Role @default(VIEWER)

  // Two-factor authentication (Better-Auth twoFactor plugin, plan/phase-19).
  twoFactorEnabled Boolean? @default(false)
  twoFactors       TwoFactor[]

  // Storage key of the uploaded avatar; `image` holds its public URL.
  avatarKey String?

  // Per-user storage quota in bytes (plan/phase-20). Null = deployment
  // default (`DEFAULT_STORAGE_QUOTA_MB`); 0 = unlimited.
  storageQuota BigInt?

  // Account lifecycle (plan/phase-22). A disabled user cannot sign in and
  // has every session revoked.
  disabledAt     DateTime?
  disabledReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations.
  sessions        Session[]
  accounts        Account[]
  ownedFiles      File[]           @relation("FileOwner")
  permissions     FilePermission[] @relation("PermissionUser")
  grantsGiven     FilePermission[] @relation("PermissionGrantedBy")
  mentions        FileMention[]    @relation("MentionTarget")
  mentionsCreated FileMention[]    @relation("MentionAuthor")
  notes           FileNote[]       @relation("NoteAuthor")
  notifications   Notification[]
  auditLogs       AuditLog[]       @relation("AuditActor")
  versionsUploaded FileVersion[]   @relation("VersionUploader")
  shareLinks       ShareLink[]     @relation("ShareLinkCreator")
  groupMemberships GroupMember[]
  groupsCreated    Group[]         @relation("GroupCreator")
  groupGrantsGiven FileGroupPermission[] @relation("GroupPermissionGrantedBy")
  foldersOwned     Folder[]        @relation("FolderOwner")
  folderGrants     FolderPermission[] @relation("FolderPermissionUser")
  folderGrantsGiven FolderPermission[] @relation("FolderPermissionGrantedBy")
  starredFiles     FileStar[]

  @@index([role])
  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

/// TOTP secret and backup codes (Better-Auth twoFactor plugin). Secrets are
/// managed by Better-Auth only; never read them from application code.
model TwoFactor {
  id          String  @id @default(cuid())
  secret      String
  backupCodes String
  userId      String
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified    Boolean @default(true)

  @@index([secret])
  @@index([userId])
  @@map("two_factor")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ─────────────────────────────────────────────────────────────────────────────
// Files. plan/phase-03, 04, 05.
// MinIO owns the binary; this row owns all relational truth. `objectKey` is the
// internal MinIO key (UUID-derived) and is never exposed as the user-facing name.
// ─────────────────────────────────────────────────────────────────────────────

model File {
  id String @id @default(uuid())

  // Ownership. Null = unowned (uploaded without user context / system resource).
  // On owner deletion the FK is set null → file is preserved as unowned
  // (plan/phase-04 §4.5), not cascaded away.
  ownerId String?
  owner   User?   @relation("FileOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  // User-visible metadata (pure DB; editing these never touches MinIO).
  displayName String
  folderPath  String @default("/")

  // Binary pointer + descriptors.
  objectKey String @unique
  mimeType  String
  size      BigInt

  // Current content version number. Incremented by every replace/restore; the
  // previous binaries are kept as `FileVersion` rows (plan/phase-13).
  version Int @default(1)
  // Who uploaded the current binary and when (renames do not touch these).
  contentUploadedById String?
  contentUpdatedAt    DateTime @default(now())

  // Small WebP preview of the current content (plan/phase-18), generated by
  // the worker for raster images. Null until generated or for other types.
  thumbnailKey String? @unique

  // SHA-256 (hex) of the current content, computed while streaming the upload
  // (plan/phase-23). Used for integrity display and duplicate detection.
  sha256 String?

  // Visibility / access configuration.
  visibility          Visibility @default(PRIVATE)
  guestAccess         Boolean    @default(false)
  isReadOnly          Boolean    @default(false)
  isMentionRestricted Boolean    @default(false)

  // Permanent presigned URL token (plan/phase-05 §5.2). Validated against the
  // file's current permission/visibility state on each access — a token, not a
  // capability.
  permanentUrlToken String? @unique

  // Lifecycle (plan/phase-05). Soft-delete first (`deletedAt`), hard-delete
  // after the grace window via the expiry job (plan/phase-09 §9.2).
  expiresAt DateTime?
  deletedAt DateTime?

  // Derived versions, e.g. compression output (plan/phase-09 §9.5).
  derivedFromId String?
  derivedFrom   File?   @relation("FileDerivation", fields: [derivedFromId], references: [id], onDelete: SetNull)
  derivatives   File[]  @relation("FileDerivation")

  // Full-text search vector (plan/phase-08). The generated-column expression
  // and GIN index are created in a raw SQL migration; Prisma only tracks the
  // column so the client stays in sync.
  searchVector Unsupported("tsvector")?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations.
  permissions   FilePermission[]
  tags          FileTag[]
  mentions      FileMention[]
  notes         FileNote[]
  notifications Notification[]
  versions      FileVersion[]
  shareLinks    ShareLink[]
  groupPermissions FileGroupPermission[]
  stars         FileStar[]

  @@index([ownerId])
  @@index([createdAt])
  @@index([deletedAt])
  @@index([visibility])
  @@index([derivedFromId])
  @@index([searchVector], type: Gin)
  @@index([sha256])
  @@map("file")
}

// ─────────────────────────────────────────────────────────────────────────────
// RBAC file-level grants. plan/phase-02-rbac.md.
// ─────────────────────────────────────────────────────────────────────────────

/// Previous content of a file (plan/phase-13). The live binary is always on the
/// `File` row; each replace/restore snapshots the outgoing binary here.
model FileVersion {
  id     String @id @default(cuid())
  fileId String
  file   File   @relation(fields: [fileId], references: [id], onDelete: Cascade)

  version   Int
  objectKey String @unique
  mimeType  String
  size      BigInt
  sha256    String?

  // Who uploaded this content and when it was originally uploaded.
  uploadedById String?
  uploadedBy   User?   @relation("VersionUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  uploadedAt   DateTime

  // When this content was superseded (moved into history).
  createdAt DateTime @default(now())

  @@unique([fileId, version])
  @@index([fileId])
  @@map("file_version")
}

model FilePermission {
  id     String @id @default(cuid())
  fileId String
  file   File   @relation(fields: [fileId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation("PermissionUser", fields: [userId], references: [id], onDelete: Cascade)
  role   Role

  grantedById String?
  grantedBy   User?   @relation("PermissionGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)

  // Optional time-limited share (plan/phase-14). Expired grants are ignored by
  // the resolver and removed by the maintenance pass.
  expiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([fileId, userId])
  @@index([userId])
  @@map("file_permission")
}

/// A named set of users (team / department) that files can be shared with
/// as a unit (plan/phase-15).
model Group {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?

  createdById String?
  createdBy   User?   @relation("GroupCreator", fields: [createdById], references: [id], onDelete: SetNull)

  members     GroupMember[]
  permissions FileGroupPermission[]
  folderPermissions FolderPermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("group")
}

/// Group membership. `isManager` members may manage the member list.
model GroupMember {
  id      String @id @default(cuid())
  groupId String
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  isManager Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([groupId, userId])
  @@index([userId])
  @@map("group_member")
}

/// File shared with a whole group (plan/phase-15). Members receive the
/// highest of their direct and group grants.
model FileGroupPermission {
  id      String @id @default(cuid())
  fileId  String
  file    File   @relation(fields: [fileId], references: [id], onDelete: Cascade)
  groupId String
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  role    Role

  grantedById String?
  grantedBy   User?   @relation("GroupPermissionGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)

  expiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([fileId, groupId])
  @@index([groupId])
  @@map("file_group_permission")
}

/// A user's starred (favourite) file (plan/phase-17).
model FileStar {
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileId String
  file   File   @relation(fields: [fileId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([userId, fileId])
  @@index([fileId])
  @@map("file_star")
}

/// A folder as a first-class entity (plan/phase-16). Files still reference
/// their location by `File.folderPath`; a Folder row adds an owner, lets the
/// folder exist while empty, and carries folder-level shares that apply to
/// every file in its subtree. Paths are normalized (`/a/b`) and globally unique.
model Folder {
  id   String @id @default(cuid())
  path String @unique
  name String

  ownerId String?
  owner   User?   @relation("FolderOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  permissions FolderPermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@map("folder")
}

/// Folder share to one user OR one group; inherited by every file and folder
/// below the shared folder.
model FolderPermission {
  id       String @id @default(cuid())
  folderId String
  folder   Folder @relation(fields: [folderId], references: [id], onDelete: Cascade)

  userId  String?
  user    User?   @relation("FolderPermissionUser", fields: [userId], references: [id], onDelete: Cascade)
  groupId String?
  group   Group?  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  role      Role
  expiresAt DateTime?

  grantedById String?
  grantedBy   User?   @relation("FolderPermissionGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([folderId, userId])
  @@unique([folderId, groupId])
  @@index([userId])
  @@index([groupId])
  @@map("folder_permission")
}

/// Public share link (plan/phase-14): anyone holding the token can view and
/// download one file, subject to optional expiry, password, and download cap.
model ShareLink {
  id     String @id @default(cuid())
  fileId String
  file   File   @relation(fields: [fileId], references: [id], onDelete: Cascade)

  token String  @unique
  label String?

  createdById String?
  createdBy   User?   @relation("ShareLinkCreator", fields: [createdById], references: [id], onDelete: SetNull)

  expiresAt     DateTime?
  passwordHash  String?
  maxDownloads  Int?
  downloadCount Int       @default(0)
  revokedAt     DateTime?
  lastAccessAt  DateTime?

  createdAt DateTime @default(now())

  @@index([fileId])
  @@map("share_link")
}

// ─────────────────────────────────────────────────────────────────────────────
// Tags + mentions + notifications. plan/phase-06-tags-mentions.md.
// ─────────────────────────────────────────────────────────────────────────────

model Tag {
  id        String    @id @default(cuid())
  value     String    @unique
  createdAt DateTime  @default(now())
  files     FileTag[]

  @@map("tag")
}

model FileTag {
  fileId String
  file   File   @relation(fields: [fileId], references: [id], onDelete: Cascade)
  tagId  String
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([fileId, tagId])
  @@index([tagId])
  @@map("file_tag")
}

/// A user mentioned in a file's metadata. Doubles as the access grant when the
/// file is mention-restricted (plan/phase-05 §5.4).
model FileMention {
  id     String @id @default(cuid())
  fileId String
  file   File   @relation(fields: [fileId], references: [id], onDelete: Cascade)

  mentionedUserId String
  mentionedUser   User   @relation("MentionTarget", fields: [mentionedUserId], references: [id], onDelete: Cascade)

  addedById String?
  addedBy   User?   @relation("MentionAuthor", fields: [addedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@unique([fileId, mentionedUserId])
  @@index([mentionedUserId])
  @@map("file_mention")
}

model Notification {
  id     String  @id @default(cuid())
  userId String
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileId String?
  file   File?   @relation(fields: [fileId], references: [id], onDelete: SetNull)

  type    String
  message String
  readAt  DateTime?

  createdAt DateTime @default(now())

  @@index([userId, readAt])
  @@map("notification")
}

// ─────────────────────────────────────────────────────────────────────────────
// File notes (versioned). plan/phase-07-notes.md.
// Each edit inserts a new row; current note = highest `version` for the file.
// ─────────────────────────────────────────────────────────────────────────────

model FileNote {
  id      String @id @default(cuid())
  fileId  String
  file    File   @relation(fields: [fileId], references: [id], onDelete: Cascade)
  version Int
  body    String

  authorId String?
  author   User?   @relation("NoteAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@unique([fileId, version])
  @@index([fileId, version(sort: Desc)])
  @@map("file_note")
}

// ─────────────────────────────────────────────────────────────────────────────
// Background jobs. plan/phase-09-jobs-bulk-compression.md.
// Redis is the live queue; this table is the durable record + DLQ flag.
// ─────────────────────────────────────────────────────────────────────────────

model Job {
  id          String    @id @default(cuid())
  type        JobType
  status      JobStatus @default(PENDING)
  payload     Json
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  result      Json?
  error       String?

  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status])
  @@index([type])
  @@map("job")
}

// ─────────────────────────────────────────────────────────────────────────────
// Audit log (append-only). plan/phase-10-audit-observability.md.
// No update/delete path is exposed through the application API.
// ─────────────────────────────────────────────────────────────────────────────

model AuditLog {
  id      String  @id @default(cuid())
  actorId String?
  actor   User?   @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  action     String
  targetType String?
  targetId   String?
  ip         String?
  metadata   Json?

  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([targetType, targetId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_log")
}
